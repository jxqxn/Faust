* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.json text eol=lf
# Original JSONC is an exact byte artifact (including CRLF and authored spaces).
content/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
assets/original/anims/** -text whitespace=-blank-at-eol,-blank-at-eof
assets/original/text/** -text
*.md text eol=lf
*.png binary
*.ogg binary
*.ttf binary

# Preserve original shader disassembly evidence, including authored spacing.
docs/ui_layout/shader_evidence/*.asm -text whitespace=-blank-at-eol
